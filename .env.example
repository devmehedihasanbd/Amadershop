# ------------------------------------------------------------------
# BazarGhor environment variables.
# Copy to .env and fill in. The app runs on mock data when
# DATABASE_URL is absent — a database is only needed for persistence.
# NEVER commit a real .env file.
# ------------------------------------------------------------------

# --- Database (Neon PostgreSQL) -------------------------------------
# Pooled connection string from the Neon dashboard (pgbouncer).
# Example: postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Optional direct (non-pooled) connection, used for migrations.
# Example: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/dbname?sslmode=require
DIRECT_URL=

# --- bKash (tokenized checkout) --------------------------------------
# From the bKash merchant dashboard after onboarding.
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta
# Live: endpoint supplied by bKash at onboarding
BKASH_BASE_URL=

# --- Nagad ------------------------------------------------------------
# From Nagad merchant onboarding.
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=
# Sandbox: http://sandbox.mynagad.com:10080
# Live: https://api.mynagad.com (confirm with Nagad docs)
NAGAD_BASE_URL=

# --- Rocket (DBBL) -----------------------------------------------------
# Rocket has NO public self-serve merchant checkout API.
# Online Rocket acceptance requires either a DBBL-issued merchant
# account + enterprise API, or a payment aggregator (SSLCommerz,
# ShurjoPay, DSSL…) that supports Rocket. Leave unset until then.
ROCKET_MODE=
ROCKET_MERCHANT_ID=
ROCKET_API_KEY=

# --- Steadfast courier --------------------------------------------------
# From https://portal.steadfast.com.bd (API section).
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.steadfast.com.bd
