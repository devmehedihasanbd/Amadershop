// Amader Shop database schema — PostgreSQL (Neon).
//
// Migrations are generated offline with:
//   npx prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script
// and applied with `npx prisma migrate deploy` once DATABASE_URL is set.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  ROCKET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  // Category photo: compressed data-URL (or https URL), shown in the
  // round category circles and the header menu. Optional — when empty
  // the circle falls back to the category's first letter.
  image       String?   @db.Text
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  description  String   @db.Text
  details      Json     @default("[]")
  price        Int // whole taka (BDT)
  oldPrice     Int?
  unit         String
  rating       Float
  reviewsCount Int      @default(0)
  badge        String?
  stock        Int      @default(100)
  // Product photos, up to 3. Stored as compressed data-URLs (or https URLs),
  // first entry is the main photo. Kept in the DB (not the filesystem)
  // because serverless deployments have no persistent local disk.
  images       String[] @default([])
  // Optional: a product may have no category (admin picks "No category").
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems OrderItem[]

  @@index([categoryId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  address   String
  area      String
  createdAt DateTime @default(now())

  // Optional customer account (guest checkout still works without one).
  // A Customer row created by an order has no passwordHash until its
  // owner registers with that same phone number.
  passwordHash String? @db.Text
  email        String? @unique
  authProvider String? // 'phone' | 'google' | 'facebook'
  providerId   String?

  orders Order[]
}

model Order {
  id                     String        @id @default(cuid())
  orderNumber            String        @unique
  customerId             String
  customer               Customer      @relation(fields: [customerId], references: [id])
  status                 OrderStatus   @default(PENDING)
  paymentMethod          PaymentMethod
  paymentStatus          PaymentStatus @default(PENDING)
  subtotal               Int
  discount               Int                  @default(0)
  promoCode              String?
  deliveryCharge         Int
  total                  Int
  notes                  String?
  steadfastConsignmentId String?
  trackingCode           String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  items OrderItem[]

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String // snapshot at order time
  unitPrice   Int // snapshot at order time (whole taka)
  qty         Int

  @@index([orderId])
}

enum BannerPlacement {
  HERO
  OFFER
}

/// Homepage banners + offer cards, fully managed from the admin panel.
/// placement HERO  -> top slider (image required)
/// placement OFFER -> "Current offers" cards (image optional; gradient fallback)
model Banner {
  id        String          @id @default(cuid())
  placement BannerPlacement @default(HERO)
  eyebrow   String?
  title     String
  subtitle  String?         @db.Text
  image     String?         @db.Text // data-URL or https URL
  link      String          @default("/")
  linkLabel String?
  sortOrder Int             @default(0)
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([placement, active])
}

model Promo {
  id          String   @id @default(cuid())
  code        String   @unique
  percent     Int
  minOrder    Int      @default(0)
  maxDiscount Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
